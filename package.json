{
  "name": "password-generator",
  "version": "1.0.0",
  "description": "ブラウザだけで動くパスワード生成アプリ(個人用)",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "node scripts/serve.js",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test:unit && npm run test:integration && npm run test:security && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "test:security": "node --test \"tests/security/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/app.test.js\"",
    "test:published": "node --test --test-concurrency=1 \"tests/e2e/published.test.js\"",
    "test:evidence": "node scripts/runEvidence.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "playwright": "1.64.1"
  }
}
